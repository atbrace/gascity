{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-gc-raw-json": true,
  "type": "object",
  "required": ["schema_version", "events"],
  "properties": {
    "schema_version": {"const": 1},
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "installation_id",
          "app",
          "release_version",
          "os",
          "occurred_hour_utc",
          "command_id"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "installation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "app": {"const": "gascity"},
          "release_version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
          },
          "os": {"enum": ["linux", "darwin"]},
          "occurred_hour_utc": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):00:00Z$"
          },
          "command_id": {"enum": ["help", "version", "unknown", "pack-command"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
